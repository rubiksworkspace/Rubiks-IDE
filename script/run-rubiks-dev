#!/usr/bin/env bash
# Build the debug IDE and run it from a "Rubiks IDE Dev.app" wrapper. macOS names
# an unbundled executable after its file ("zed") in the menu bar and Dock; only a
# bundle's Info.plist can name it "Rubiks IDE". Extra arguments go to the IDE.
set -euo pipefail

cd "$(dirname "$0")/.."
cargo build

app="target/debug/Rubiks IDE Dev.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"

# Hard link, refreshed every run: cargo replaces the binary on each build, and the
# debug binary is too large to copy each time.
ln -f target/debug/zed "$app/Contents/MacOS/zed"

if [[ ! -f "$app/Contents/Resources/app.icns" ]]; then
    # sips can't write .icns directly; iconutil builds it from an .iconset of PNGs.
    iconset="$(mktemp -d)/app.iconset"
    mkdir -p "$iconset"
    for size in 16 32 128 256 512; do
        sips -z "$size" "$size" crates/zed/resources/app-icon-dev@2x.png \
            --out "$iconset/icon_${size}x${size}.png" >/dev/null
        sips -z $((size * 2)) $((size * 2)) crates/zed/resources/app-icon-dev@2x.png \
            --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    iconutil -c icns "$iconset" -o "$app/Contents/Resources/app.icns"
fi

cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Rubiks IDE Dev</string>
    <key>CFBundleDisplayName</key><string>Rubiks IDE Dev</string>
    <key>CFBundleExecutable</key><string>zed</string>
    <key>CFBundleIdentifier</key><string>dev.zed.Zed-Dev</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleIconFile</key><string>app</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSMinimumSystemVersion</key><string>10.15.7</string>
</dict>
</plist>
PLIST

# Run the bundled executable directly so logs stay in this terminal.
exec "$app/Contents/MacOS/zed" "$@"
